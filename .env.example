# STACK cloud backend public client configuration.
# Supabase URLs and publishable keys are browser-visible by design; RLS and
# RPC permissions provide the security boundary. Never put service-role keys
# or personal Intervals credentials in VITE_ variables.
#
# Vercel Production:
#   VITE_STACK_BACKEND_ENV=production
#   VITE_SUPABASE_URL=<stack-run production URL>
#   VITE_SUPABASE_PUBLISHABLE_KEY=<stack-run production publishable key>
#
# Vercel Preview and local cloud QA:
#   VITE_STACK_BACKEND_ENV=preview
#   VITE_SUPABASE_URL=<stack-run-preview URL>
#   VITE_SUPABASE_PUBLISHABLE_KEY=<stack-run-preview publishable key>
VITE_STACK_BACKEND_ENV=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Each runner's personal Intervals API key is entered through STACK on that
# runner's device and stored locally through the credential repository. It is
# never a Vercel/Supabase environment variable and is never cloud-synced.
