# Race Crew public client configuration.
# These are intentionally VITE_ variables because the Supabase project URL
# and publishable key are public browser configuration. RLS provides security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy single-owner Connected Training proxy secrets.
# Keep these during UI-18 migration until the new device-local personal API-key
# connection is verified on the owner's production iPhone/Safari.
# Never prefix these with VITE_. Never commit real values.
INTERVALS_API_KEY=
STACK_SYNC_TOKEN=

# Each Race Crew runner's personal Intervals API key is NOT an env variable.
# It is entered through STACK on that runner's device and stored locally through
# the dedicated credential repository outside AppState.
